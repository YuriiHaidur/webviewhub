<UserControl x:Class="WebViewHub.Controls.ResponsiveCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             SizeChanged="OnSizeChanged">
    <!-- Matches ui:Card's Fluent look (bg, border, rounded corners) so the
         row blends with surrounding ui:CardControl rows on the page. -->
    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="14,12">
        <Grid x:Name="LayoutGrid">
            <Grid.ColumnDefinitions>
                <!-- Col 0: icon -->
                <ColumnDefinition Width="Auto" />
                <!-- Col 1: header (Title + Description) -->
                <ColumnDefinition Width="*" />
                <!-- Col 2: input field; toggled to Width=0 in compact mode -->
                <ColumnDefinition x:Name="FieldCol" Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="CompactRow" Height="0" />
            </Grid.RowDefinitions>

            <ContentPresenter x:Name="IconHost"
                              Grid.Row="0" Grid.Column="0"
                              VerticalAlignment="Center"
                              Margin="0,0,14,0"
                              Content="{Binding Icon, RelativeSource={RelativeSource AncestorType=UserControl}}" />

            <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                <ui:TextBlock FontTypography="Body"
                              Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <ui:TextBlock FontTypography="Caption"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              TextWrapping="Wrap"
                              Text="{Binding Description, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              Visibility="{Binding DescriptionVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            </StackPanel>

            <!-- Default position (wide mode): right side, same row as header.
                 OnSizeChanged moves this to row=1 col=1 when the card is
                 too narrow for icon + header + input to fit on one line. -->
            <ContentPresenter x:Name="FieldHost"
                              Grid.Row="0" Grid.Column="2"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Right"
                              Margin="16,0,0,0"
                              Content="{Binding Field, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </Grid>
    </Border>
</UserControl>
