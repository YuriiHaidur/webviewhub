<ui:FluentWindow x:Class="WebViewHub.Windows.ServiceSettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:pages="clr-namespace:WebViewHub.Windows.Pages"
                 x:Name="Root"
                 Width="1120" Height="880"
                 MinWidth="820" MinHeight="560"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 WindowStartupLocation="CenterScreen"
                 ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
                 ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" x:Name="TitleBar" Title="Service settings" />

        <ui:NavigationView Grid.Row="1"
                           x:Name="Nav"
                           PaneDisplayMode="Left"
                           OpenPaneLength="280"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="True"
                           IsTopSeparatorVisible="False"
                           IsFooterSeparatorVisible="False">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="General"     TargetPageType="{x:Type pages:GeneralPage}"     Icon="{ui:SymbolIcon Tag24}" />
                <ui:NavigationViewItem Content="Window"      TargetPageType="{x:Type pages:WindowPage}"      Icon="{ui:SymbolIcon Window24}" />
                <ui:NavigationViewItem Content="Shortcut"    TargetPageType="{x:Type pages:ShortcutPage}"    Icon="{ui:SymbolIcon Keyboard24}" />
                <ui:NavigationViewItem Content="Integration" TargetPageType="{x:Type pages:IntegrationPage}" Icon="{ui:SymbolIcon PlugConnected24}" />
                <ui:NavigationViewItem Content="Tweaks"      TargetPageType="{x:Type pages:TweaksPage}"      Icon="{ui:SymbolIcon PaintBrush24}" />
            </ui:NavigationView.MenuItems>
        </ui:NavigationView>

        <Border Grid.Row="2"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Cancel"
                           Appearance="Secondary"
                           Click="Cancel_Click"
                           Margin="0,0,8,0" />
                <ui:Button Content="Save"
                           Appearance="Primary"
                           IsEnabled="{Binding CanSave, ElementName=Root}"
                           ToolTip="{Binding SaveBlockedReason, ElementName=Root}"
                           ToolTipService.ShowOnDisabled="True"
                           Click="Save_Click" />
            </StackPanel>
        </Border>

        <!-- ContentDialog overlay host — must span all Grid rows so the
             dialog can dim the entire window contents. -->
        <ui:ContentDialogHost x:Name="DialogHost" Grid.RowSpan="3" />
    </Grid>
</ui:FluentWindow>
