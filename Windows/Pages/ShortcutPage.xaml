<Page x:Class="WebViewHub.Windows.Pages.ShortcutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:WebViewHub.Controls"
      Title="Shortcut"
      d:DesignHeight="450" d:DesignWidth="800"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      mc:Ignorable="d">
    <ui:DynamicScrollViewer VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="42">
            <ui:TextBlock FontTypography="Title" Text="Shortcut" />
            <ui:TextBlock FontTypography="Body"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Text="Open and dismiss the service from anywhere"
                          Margin="0,4,0,24" />

            <ui:CardExpander Icon="{ui:SymbolIcon Keyboard24}" IsExpanded="True">
                <ui:CardExpander.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="Body" Text="Hotkey" />
                        <ui:TextBlock FontTypography="Caption"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      Text="{Binding HotkeyDisplay}" />
                    </StackPanel>
                </ui:CardExpander.Header>

                <StackPanel>
                    <controls:ResponsiveCard Icon="{ui:SymbolIcon Keyboard24}"
                                             Title="Key combination"
                                             Description="Click field, press the keys you want">
                        <StackPanel Orientation="Horizontal">
                            <ui:TextBox Width="200" IsReadOnly="True"
                                        FontFamily="Cascadia Mono, Consolas"
                                        PlaceholderText="Click and press keys…"
                                        Text="{Binding Hotkey, Mode=OneWay}"
                                        PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                            <ui:Button Content="Clear" Margin="8,0,0,0"
                                       Appearance="Secondary"
                                       Click="Clear_Click" />
                        </StackPanel>
                    </controls:ResponsiveCard>
                    <ui:CardControl Margin="0,4,0,0" Icon="{ui:SymbolIcon EyeOff24}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock FontTypography="Body" Text="Auto-close on focus loss" />
                                <ui:TextBlock FontTypography="Caption"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                              Text="Hide when you click outside" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch IsChecked="{Binding CloseOnFocusLost}" />
                    </ui:CardControl>
                </StackPanel>
            </ui:CardExpander>
        </StackPanel>
    </ui:DynamicScrollViewer>
</Page>
