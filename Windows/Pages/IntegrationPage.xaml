<Page x:Class="WebViewHub.Windows.Pages.IntegrationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:WebViewHub.Controls"
      Title="Integration"
      d:DesignHeight="450" d:DesignWidth="800"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      mc:Ignorable="d">
    <ui:DynamicScrollViewer VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="42">
            <ui:TextBlock FontTypography="Title" Text="Integration" />
            <ui:TextBlock FontTypography="Body"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Text="Custom links and clipboard tools"
                          Margin="0,4,0,24" />

            <ui:CardExpander Margin="0,0,0,4" Icon="{ui:SymbolIcon Link24}">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <ui:TextBlock FontTypography="Body" Text="URI handler" />
                            <ui:TextBlock FontTypography="Caption"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                          Text="Route clicks on custom links into this service" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1"
                                         IsChecked="{Binding RegisterProtocol}"
                                         Margin="16,0,16,0"
                                         PreviewMouseLeftButtonDown="HeaderToggle_PreviewMouseLeftButtonDown" />
                    </Grid>
                </ui:CardExpander.Header>

                <StackPanel>
                    <controls:ResponsiveCard Icon="{ui:SymbolIcon TextField24}"
                                             Title="Scheme"
                                             Description="When you click slack://… anywhere in Windows, open it here">
                        <ui:TextBox Width="280" FontFamily="Cascadia Mono, Consolas"
                                    PlaceholderText="myapp"
                                    Text="{Binding ProtocolScheme, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                    </controls:ResponsiveCard>
                </StackPanel>
            </ui:CardExpander>

            <ui:CardExpander Icon="{ui:SymbolIcon Translate24}">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <ui:TextBlock FontTypography="Body" Text="Translator" />
                            <ui:TextBlock FontTypography="Caption"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                          Text="Powered by Google Translate" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1"
                                         IsChecked="{Binding IsTranslator}"
                                         Margin="16,0,16,0"
                                         PreviewMouseLeftButtonDown="HeaderToggle_PreviewMouseLeftButtonDown" />
                    </Grid>
                </ui:CardExpander.Header>

                <StackPanel>
                    <controls:ResponsiveCard Icon="{ui:SymbolIcon LocalLanguage24}"
                                             Title="Target language"
                                             Description="Source is auto-detected">
                        <ComboBox Width="280"
                                  SelectedValue="{Binding TranslatorTargetLang}"
                                  SelectedValuePath="Tag">
                            <ComboBoxItem Content="English"    Tag="en" />
                            <ComboBoxItem Content="Spanish"    Tag="es" />
                            <ComboBoxItem Content="French"     Tag="fr" />
                            <ComboBoxItem Content="German"     Tag="de" />
                            <ComboBoxItem Content="Russian"    Tag="ru" />
                            <ComboBoxItem Content="Italian"    Tag="it" />
                            <ComboBoxItem Content="Portuguese" Tag="pt" />
                            <ComboBoxItem Content="Chinese"    Tag="zh" />
                            <ComboBoxItem Content="Japanese"   Tag="ja" />
                        </ComboBox>
                    </controls:ResponsiveCard>
                    <ui:CardControl Margin="0,4,0,0" Icon="{ui:SymbolIcon Copy24}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock FontTypography="Body" Text="Use double Ctrl+C trigger" />
                                <ui:TextBlock FontTypography="Caption"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                              Text="Tap Ctrl+C twice anywhere to translate the clipboard" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch IsChecked="{Binding UseDoubleCtrlC}" />
                    </ui:CardControl>
                </StackPanel>
            </ui:CardExpander>
        </StackPanel>
    </ui:DynamicScrollViewer>
</Page>
