<ui:FluentWindow x:Class="WebViewHub.Windows.HubSettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:WebViewHub.Controls"
                 xmlns:models="clr-namespace:WebViewHub.Models"
                 x:Name="Root"
                 Title="Hub settings"
                 Width="720" Height="640"
                 MinWidth="540" MinHeight="480"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 WindowStartupLocation="CenterScreen"
                 ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
                 ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Hub settings">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Resources/AppIcon.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ui:DynamicScrollViewer Grid.Row="1"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="42,16,42,16">
                <ui:TextBlock FontTypography="Title" Text="Hub settings" />
                <ui:TextBlock FontTypography="Body"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              Text="App-wide preferences for WebViewHub itself"
                              Margin="0,4,0,24" />

                <ui:TextBlock FontTypography="BodyStrong" Text="Icons" Margin="0,0,0,8" />

                <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Sparkle24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="Body" Text="Icon source" />
                            <ui:TextBlock FontTypography="Caption"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                          TextWrapping="Wrap"
                                          Text="Where to fetch icons for new services." />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ComboBox Width="200"
                              SelectedValue="{Binding IconSource, Mode=TwoWay}"
                              SelectedValuePath="Tag">
                        <ComboBoxItem Content="Standard (favicons only)" Tag="{x:Static models:IconSource.Standard}" />
                        <ComboBoxItem Content="WebCatalog (free curated)" Tag="{x:Static models:IconSource.WebCatalog}" />
                        <ComboBoxItem Content="macOSicons (with API key)" Tag="{x:Static models:IconSource.MacOSIcons}" />
                    </ComboBox>
                </ui:CardControl>

                <controls:ResponsiveCard Margin="0,0,0,4"
                                         Icon="{ui:SymbolIcon Key24}"
                                         Title="API key"
                                         Description="Get one at docs.macosicons.com."
                                         Visibility="{Binding IsMacOSIconsSelected, Converter={StaticResource BoolToVis}}">
                    <ui:TextBox Width="280"
                                FontFamily="Cascadia Mono, Consolas"
                                PlaceholderText="paste key from docs.macosicons.com…"
                                Text="{Binding MacOSIconsApiKey, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                </controls:ResponsiveCard>

                <ui:TextBlock FontTypography="Caption"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              TextWrapping="Wrap"
                              Text="Icons from macOSicons.com — credit goes to the original uploaders. Personal/non-commercial use only per the API guidelines."
                              Margin="0,4,0,16"
                              Visibility="{Binding IsMacOSIconsSelected, Converter={StaticResource BoolToVis}}" />

                <ui:TextBlock FontTypography="BodyStrong" Text="Launch" Margin="0,16,0,8" />

                <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon AppsAddIn24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="Body" Text="Add to Start menu" />
                            <ui:TextBlock FontTypography="Caption"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                          Text="Find WebViewHub from Windows Search and Start" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding HasShortcut, Mode=TwoWay}" />
                </ui:CardControl>

                <ui:CardExpander Margin="0,0,0,4" Icon="{ui:SymbolIcon Power24}">
                    <ui:CardExpander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <ui:TextBlock FontTypography="Body" Text="Start automatically with Windows" />
                                <ui:TextBlock FontTypography="Caption"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                              Text="Runs WebViewHub at Windows sign-in" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1"
                                             IsChecked="{Binding HubAutoStart, Mode=TwoWay}"
                                             Margin="16,0,16,0"
                                             PreviewMouseLeftButtonDown="HeaderToggle_PreviewMouseLeftButtonDown" />
                        </Grid>
                    </ui:CardExpander.Header>

                    <StackPanel>
                        <ui:CardControl Icon="{ui:SymbolIcon EyeOff24}">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <ui:TextBlock FontTypography="Body" Text="Start hidden in tray" />
                                    <ui:TextBlock FontTypography="Caption"
                                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                  Text="Sit silently in the tray instead of opening the Hub window on boot" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch IsChecked="{Binding HubStartHidden, Mode=TwoWay}" />
                        </ui:CardControl>
                    </StackPanel>
                </ui:CardExpander>
            </StackPanel>
        </ui:DynamicScrollViewer>

        <Border Grid.Row="2"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Cancel"
                           Appearance="Secondary"
                           Click="Cancel_Click"
                           Margin="0,0,8,0" />
                <ui:Button Content="Save"
                           Appearance="Primary"
                           IsEnabled="{Binding CanSave, ElementName=Root}"
                           Click="Save_Click" />
            </StackPanel>
        </Border>

        <!-- ContentDialog overlay host — must span all Grid rows so the
             dialog can dim the entire window contents. Used by the
             unsaved-changes prompt on close. -->
        <ui:ContentDialogHost x:Name="DialogHost" Grid.RowSpan="3" />
    </Grid>
</ui:FluentWindow>
