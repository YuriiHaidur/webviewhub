<ui:FluentWindow x:Class="WebViewHub.Windows.IconPickerWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:sys="clr-namespace:System;assembly=mscorlib"
                 x:Name="Root"
                 Title="Choose icon"
                 Width="680" Height="640"
                 MinWidth="540" MinHeight="420"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 WindowStartupLocation="CenterOwner"
                 ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
                 ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <ui:FluentWindow.Resources>
        <!-- Shared visual for the single-preview card used in Standard
             and WebCatalog tabs. Each tab instantiates its own Border —
             WPF elements can only have one parent, so we can't share an
             instance — but the Style keeps the visuals identical. -->
        <Style x:Key="SinglePreviewCardStyle" TargetType="Border">
            <Setter Property="MinWidth" Value="200" />
            <Setter Property="MaxWidth" Value="240" />
            <Setter Property="Height" Value="240" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,12,0,0" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="SinglePreviewHeaderStyle" TargetType="Border">
            <Setter Property="Height" Value="150" />
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="CornerRadius" Value="6,6,0,0" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" x:Name="TitleBarCtrl" Title="Choose icon" />

        <!-- Wpf.Ui's ControlsDictionary themes the standard TabControl
             with Fluent-style rounded tabs, hover states, and proper
             dark-theme colours — no custom template needed. Each tab
             carries its own search + result UI; SelectionChanged triggers
             the source-specific fetch. -->
        <TabControl Grid.Row="1"
                    x:Name="SourceTabs"
                    Margin="24,12,24,0"
                    SelectionChanged="SourceTabs_SelectionChanged">

            <!-- Standard — favicon from service URL host. No search box;
                 host is derived from the URL the caller passed in. -->
            <TabItem x:Name="TabStandard">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Globe24" Margin="0,0,6,0" />
                        <TextBlock Text="Standard" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               x:Name="StandardStatusText"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,4" />
                    <Border Grid.Row="1"
                            x:Name="StandardPreviewCard"
                            Style="{StaticResource SinglePreviewCardStyle}"
                            Visibility="Collapsed"
                            MouseLeftButtonUp="SinglePreview_MouseLeftButtonUp">
                        <StackPanel>
                            <Border Style="{StaticResource SinglePreviewHeaderStyle}">
                                <Image x:Name="StandardPreviewImage"
                                       Width="96" Height="96"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Clip>
                                        <RectangleGeometry Rect="0,0,96,96" RadiusX="22" RadiusY="22" />
                                    </Image.Clip>
                                </Image>
                            </Border>
                            <StackPanel Margin="14,14,14,0">
                                <TextBlock x:Name="StandardPreviewName"
                                           FontWeight="SemiBold" FontSize="13"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="StandardPreviewSource"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontSize="11"
                                           Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- WebCatalog — slugify query name, fetch from cdn-1.webcatalog.io. -->
            <TabItem x:Name="TabWebCatalog">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Apps24" Margin="0,0,6,0" />
                        <TextBlock Text="WebCatalog" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0"
                                    x:Name="WebCatalogQueryBox"
                                    PlaceholderText="Service name (becomes the webcatalog.io slug)"
                                    KeyDown="QueryBox_KeyDown" />
                        <ui:Button Grid.Column="1"
                                   Content="Search"
                                   Appearance="Primary"
                                   Icon="{ui:SymbolIcon Search24}"
                                   Click="Search_Click"
                                   Margin="8,0,0,0" />
                    </Grid>
                    <TextBlock Grid.Row="1"
                               x:Name="WebCatalogStatusText"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0" />
                    <Border Grid.Row="2"
                            x:Name="WebCatalogPreviewCard"
                            Style="{StaticResource SinglePreviewCardStyle}"
                            Visibility="Collapsed"
                            MouseLeftButtonUp="SinglePreview_MouseLeftButtonUp">
                        <StackPanel>
                            <Border Style="{StaticResource SinglePreviewHeaderStyle}">
                                <Image x:Name="WebCatalogPreviewImage"
                                       Width="96" Height="96"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Clip>
                                        <RectangleGeometry Rect="0,0,96,96" RadiusX="22" RadiusY="22" />
                                    </Image.Clip>
                                </Image>
                            </Border>
                            <StackPanel Margin="14,14,14,0">
                                <TextBlock x:Name="WebCatalogPreviewName"
                                           FontWeight="SemiBold" FontSize="13"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="WebCatalogPreviewSource"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontSize="11"
                                           Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- macOSicons — full search-and-browse grid. -->
            <TabItem x:Name="TabMacOSIcons">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Sparkle24" Margin="0,0,6,0" />
                        <TextBlock Text="macOSicons" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0"
                                    x:Name="MacIconsQueryBox"
                                    PlaceholderText="Search macOSicons by app name…"
                                    KeyDown="QueryBox_KeyDown" />
                        <ui:Button Grid.Column="1"
                                   Content="Search"
                                   Appearance="Primary"
                                   Icon="{ui:SymbolIcon Search24}"
                                   Click="Search_Click"
                                   Margin="8,0,0,0" />
                        <ui:Button Grid.Column="2"
                                   x:Name="RefreshButton"
                                   Icon="{ui:SymbolIcon ArrowSync24}"
                                   Appearance="Transparent"
                                   ToolTip="Re-fetch (bypasses local cache)"
                                   Click="Refresh_Click"
                                   MinHeight="32"
                                   Padding="8,0"
                                   Margin="4,0,0,0">
                            <ui:Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver"
                                                 Color="{DynamicResource SubtleFillColorSecondary}" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed"
                                                 Color="{DynamicResource SubtleFillColorTertiary}" />
                            </ui:Button.Resources>
                        </ui:Button>
                    </Grid>
                    <TextBlock Grid.Row="1"
                               x:Name="CacheStatusText"
                               Margin="2,6,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Visibility="Collapsed" />
                    <Grid Grid.Row="2" Margin="0,4,0,0">
                        <ui:DynamicScrollViewer x:Name="ResultsScroll"
                                                VerticalScrollBarVisibility="Auto"
                                                HorizontalScrollBarVisibility="Disabled"
                                                PreviewMouseWheel="ResultsScroll_PreviewMouseWheel">
                            <ItemsControl x:Name="ResultsList" Padding="0,0,0,12">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border MinWidth="140" MaxWidth="140" Height="180"
                                                Margin="0,0,12,12"
                                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{Binding BorderBrush}"
                                                BorderThickness="2"
                                                CornerRadius="8"
                                                Cursor="Hand"
                                                Tag="{Binding}"
                                                MouseLeftButtonUp="Card_MouseLeftButtonUp"
                                                ToolTip="{Binding TooltipText}">
                                            <StackPanel>
                                                <Border Height="100"
                                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                        CornerRadius="6,6,0,0">
                                                    <Image Source="{Binding Thumbnail}"
                                                           Width="64" Height="64"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           RenderOptions.BitmapScalingMode="HighQuality">
                                                        <Image.Clip>
                                                            <RectangleGeometry Rect="0,0,64,64" RadiusX="14" RadiusY="14" />
                                                        </Image.Clip>
                                                    </Image>
                                                </Border>
                                                <StackPanel Margin="10,8,10,0">
                                                    <TextBlock Text="{Binding Hit.AppName}"
                                                               FontWeight="SemiBold" FontSize="12"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding DownloadsText}"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               FontSize="11"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ui:DynamicScrollViewer>
                        <ui:TextBlock x:Name="MacIconsStatusText"
                                      FontTypography="Body"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed" />
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Cancel"
                           Appearance="Secondary"
                           Click="Cancel_Click"
                           Margin="0,0,8,0" />
                <ui:Button x:Name="ApplyButton"
                           Content="Apply"
                           Appearance="Primary"
                           IsEnabled="False"
                           Click="Apply_Click" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
