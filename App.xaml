<Application x:Class="WebViewHub.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:helpers="clr-namespace:WebViewHub.Helpers"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Initial theme — overridden at startup by App.OnStartup
                     based on the current Windows system theme; kept in sync
                     by SystemThemeWatcher. -->
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <helpers:UserAgentIsCustomToVisibilityConverter x:Key="UserAgentIsCustomToVisibility" />
            <helpers:StringNotEmptyToVisibleConverter        x:Key="StringNotEmptyToVisible" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
